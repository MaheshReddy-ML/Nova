# Fast voice brain (one is required; checked in this order). Groq: https://console.groq.com/keys
# Gemini: https://aistudio.google.com/apikey · NVIDIA: https://build.nvidia.com (Nova's NVIDIA_API_KEY is reused automatically)
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional model override (default llama-3.3-70b-versatile on Groq, gemini-2.0-flash on Gemini)
VOICE_BRIDGE_MODEL=

# ntfy: install the ntfy app, subscribe to this topic, and allow urgent notifications to break through Do Not Disturb.
# Pick a long, unguessable topic name: anyone who knows it can send you notifications.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# Public HTTPS URL that forwards to the call page (e.g. `cloudflared tunnel --url http://127.0.0.1:7860`).
PUBLIC_TUNNEL_URL=
VOICE_BRIDGE_HOST=127.0.0.1
VOICE_BRIDGE_PORT=7860

# Local speech: moonshine/base or moonshine/tiny; Kokoro voice (af_heart, am_michael, bf_emma, ...)
VOICE_BRIDGE_STT=moonshine/base
VOICE_BRIDGE_VOICE=af_heart

# Timeouts in seconds
VOICE_BRIDGE_JOIN_TIMEOUT=600
VOICE_BRIDGE_CALL_TIMEOUT=900
VOICE_BRIDGE_IDLE_TIMEOUT=60
