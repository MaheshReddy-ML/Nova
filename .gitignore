# ─────────────────────────────────────────────────────────────
# Nova — .gitignore
# Rule of thumb: commit code, docs and reviewed assets;
# never commit secrets, personal data, generated output or caches.
# ─────────────────────────────────────────────────────────────

# ── Secrets & local configuration ───────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
credentials*.json
service-account*.json
.claude/settings.local.json

# ── Personal data & runtime state (stays on your machine) ───
# Profile, SQLite database, mission memory and model caches
memory/
# Generated website concepts, screenshots and proposals
workspace/
# Benchmarks, exports and test artefacts
output/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.lock
!uv.lock

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
wheels/
*.egg-info/
.eggs/
pip-wheel-metadata/
.installed.cfg
*.egg
MANIFEST

# ── Virtual environments (uv / venv / conda) ────────────────
.venv/
venv/
env/
ENV/
**/.venv/
.python-version.local
.conda/

# ── Testing, coverage & type checking ───────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/
.tox/
.nox/
.mypy_cache/
.pyright/
.ruff_cache/
.dmypy.json
dmypy.json

# ── Browser automation ──────────────────────────────────────
.playwright-cli/
playwright-report/
test-results/
blob-report/

# ── Models & media caches (downloaded at runtime) ───────────
*.onnx
!nova/**/*.onnx.keep
.cache/
huggingface/
models/
*.wav
*.mp3
*.webm

# ── Logs & temporary files ──────────────────────────────────
*.log
logs/
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
nohup.out
tunnel.log

# ── Editors & IDEs ──────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.idea/
*.iml
*.sublime-project
*.sublime-workspace
.history/
.fleet/
.zed/

# ── Operating systems ───────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── Node (if front-end tooling is added later) ──────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.next/
.turbo/

# ── Voice bridge (standalone module) ────────────────────────
voice_bridge/.venv/
voice_bridge/.env
