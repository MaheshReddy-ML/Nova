# Agent identity
AGENT_NAME=NOVA
AGENT_VERSION=0.1.0
APP_ENV=development

# NVIDIA Build trial. Keep real credentials only in .env.
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
FAST_MODEL=nvidia/nemotron-3.5-bolt-e4b
PLANNER_MODEL=nvidia/nemotron-3.5-bolt-e4b
REASONING_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
CODING_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b

# NVIDIA-hosted speech
VOICE_ENABLED=true
SPEECH_STREAMING=true
STT_MODEL=parakeet-ctc-1.1b-asr
STT_BASE_URL=https://1598d209-5e27-4d3c-8079-4751568b1081.invocation.api.nvcf.nvidia.com
TTS_MODEL=magpie-tts-multilingual
TTS_BASE_URL=https://877104f7-e885-42b9-8de8-f6e4c6303969.invocation.api.nvcf.nvidia.com
TTS_VOICE=Magpie-Multilingual.EN-US.Sofia
TTS_LANGUAGE=en-US
MAX_SPEECH_CALLS_HOUR=36

# Runtime budgets
AUTONOMOUS_MODE=false
WORKERS=2
MAX_AGENT_STEPS=25
MAX_RETRIES=3
MAX_TASK_SECONDS=180
MAX_INPUT_TOKENS=4096
MAX_OUTPUT_TOKENS=1024
MAX_TASK_TOKENS=12000
MAX_DAILY_TOKENS=50000
MAX_CALLS_HOUR=30
MAX_TASK_MODEL_CALLS=6
MAX_DAILY_EXPENSE_INR=0

# External business action controls
REQUIRE_OUTREACH_APPROVAL=true
REQUIRE_DEPLOYMENT_APPROVAL=true
REQUIRE_PAYMENT_APPROVAL=true

# Local service and storage
HOST=127.0.0.1
PORT=8000
DATABASE_PATH=memory/nova.db
WORKSPACE_PATH=workspace
LOG_LEVEL=INFO
