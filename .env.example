# Agent identity
AGENT_NAME=Nova
AGENT_VERSION=2.0.0
APP_ENV=development

# ─── NVIDIA models ─────────────────────────────────────────────────────────────────────────────────
# Keep real credentials only in .env. Use model IDs exactly as your key's catalogue lists them:
#   uv run nova check-nvidia            lists access
#   uv run python tools/model_bench.py  measures every chat model on Nova's real jobs (results: Model Observatory)
# An ID that is not in your catalogue silently falls back to a small default, so copy IDs from the list below.
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Conversation + tool calling (every spoken/typed request). Needs accurate tool choice and a fast first reply.
#   nvidia/nemotron-3.5-super-vl-120b-a12b recommended: 4/4 correct tool choices, ~0.8 s per call, 0.3 s to first word
#   nvidia/nemotron-3.5-lightning-30b-a3b  3/4 tool choices, ~0.7 s per call
#   nvidia/nemotron-3-ultra-550b-a55b      4/4 but ~8 s per call: too slow for multi-step voice turns
AGENT_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
AGENT_MAX_STEPS=5

# Small talk, greetings and streamed chat. Fastest model wins.
FAST_MODEL=nvidia/nemotron-3.5-bolt-e4b

# Planning briefs and design prioritisation. Runs in the background, so depth matters more than speed.
#   nvidia/nemotron-3-ultra-550b-a55b      recommended: most concrete plans; 30-120 s per brief and occasionally times out,
#                                          in which case Nova automatically retries with Super. (Successor to
#                                          llama-3.1-nemotron-ultra-253b-v1, which is NOT available on this key.)
#   nvidia/nemotron-3.5-super-vl-120b-a12b fast and reliable (~2 s per brief)
PLANNER_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Long-form reasoning and code generation.
REASONING_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
CODING_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# Website plans (copy + art direction for the design kit). Measured: Super 74.6 in 6 s, Bolt 76.8 in 8 s, Ultra 76.0 in 77 s
# (scores are within critic noise), so Super is the default for speed and reliability.
SITE_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# Screenshot critique for website concepts.
VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Semantic memory search.
EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b

# Catalogue reference (benchmarked on this key, Nov 2026; re-run with tools/model_bench.py):
#   model                               tool calls  per call  first word  site plan
#   nvidia/nemotron-3.5-super-vl-120b    4/4         0.8 s     0.3 s       74.6 (6 s)
#   nvidia/nemotron-3-ultra-550b         4/4         8.1 s     0.9 s       76.0 (77 s)
#   nvidia/nemotron-3.5-bolt-e4b         3/4         0.6 s     0.2 s       76.8 (8 s)
#   nvidia/nemotron-3.5-lightning-30b    3/4         0.7 s     0.3 s       malformed JSON once (retried in real builds)
#   stepfun-ai/step-5-preview            4/4         11.9 s    9.7 s       timed out
#   mistralai/mistral-large-4-1t-a52b    3/4         7.0 s     12.2 s      timed out
#   minimaxai/minimax-m3.1-flash         2/4         31.8 s    16.5 s      invalid JSON
#   moonshotai/kimi-k3.1-pro             timed out (>90 s): not usable interactively today
#   z-ai/glm-5.3-flash                   timed out (>90 s): not usable interactively today
#   google/gemma-3-12b-it                not enabled for this account (HTTP 404)
#   DeepSeek models are not in this key's catalogue.

# NVIDIA-hosted speech
VOICE_ENABLED=true
SPEECH_STREAMING=true
STT_MODEL=parakeet-ctc-1.1b-asr
STT_BASE_URL=https://1598d209-5e27-4d3c-8079-4751568b1081.invocation.api.nvcf.nvidia.com
TTS_MODEL=magpie-tts-multilingual
TTS_BASE_URL=https://877104f7-e885-42b9-8de8-f6e4c6303969.invocation.api.nvcf.nvidia.com
TTS_VOICE=Magpie-Multilingual.EN-US.Sofia
TTS_LANGUAGE=en-US
MAX_SPEECH_CALLS_HOUR=300

# ─── Deepgram Aura text to speech (recommended voice) ──────────────────────────────────────────────
# TTS_PROVIDER: auto (Deepgram when DEEPGRAM_API_KEY is set, else NVIDIA Magpie), deepgram or nvidia.
# Speech recognition stays on NVIDIA Parakeet. If Deepgram fails (network, credits), Nova speaks that phrase
# with Magpie instead; a rejected key or exhausted credits switches to Magpie for the rest of the session.
# Get a key at https://console.deepgram.com (new accounts include free credit). Aura-2 costs about $0.03 per
# 1,000 characters, so $200 of credit is roughly 6.6 million spoken characters.
TTS_PROVIDER=auto
DEEPGRAM_API_KEY=
# Feminine Aura-2 voices that suit Nova (pick live in the dashboard's Voice menu, then set your favourite here):
#   aura-2-athena-en    calm, smooth, professional (default: composed chief-of-staff)
#   aura-2-hera-en      smooth, warm, professional
#   aura-2-cora-en      smooth, melodic, caring
#   aura-2-harmonia-en  empathetic, clear, calm, confident
#   aura-2-pandora-en   British; smooth, calm, melodic
#   aura-2-thalia-en    clear, confident, energetic
#   aura-2-vesta-en     natural, expressive, patient
#   aura-2-helena-en    caring, friendly, slightly raspy
DEEPGRAM_VOICE=aura-2-athena-en


# Website builder: kit (model plans copy + direction, NOVA's design system renders it with real photos and fonts; best),
# model (model writes raw HTML/CSS) or template (deterministic)
SITE_BUILDER=kit
SITE_REVISION_ROUNDS=1

# Runtime budgets: Nova's own safety caps. NVIDIA's free tier limits each model to roughly 40 requests/minute;
# these defaults use the free tier fully for daily work while staying under it.
AUTONOMOUS_MODE=false
WORKERS=2
MAX_AGENT_STEPS=25
MAX_RETRIES=3
MAX_TASK_SECONDS=600
MAX_INPUT_TOKENS=4096
MAX_OUTPUT_TOKENS=1024
MAX_TASK_TOKENS=200000
MAX_DAILY_TOKENS=3000000
MAX_CALLS_HOUR=600
MAX_TASK_MODEL_CALLS=20
MAX_DAILY_EXPENSE_INR=0
SKILL_CONTEXT_BUDGET=550

# Search and local business data (both have free tiers; strongly recommended for reliable research)
# Brave Search API: https://brave.com/search/api/   Google Places API (New): https://developers.google.com/maps/documentation/places/web-service
BRAVE_SEARCH_API_KEY=
GOOGLE_PLACES_API_KEY=

# Optional public business lookup contact and private owner notifications
WIKIDATA_CONTACT=
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# External business action controls
REQUIRE_OUTREACH_APPROVAL=true
REQUIRE_DEPLOYMENT_APPROVAL=true
REQUIRE_PAYMENT_APPROVAL=true

# Local service and storage
HOST=127.0.0.1
PORT=8000
DATABASE_PATH=memory/nova.db
WORKSPACE_PATH=workspace
LOG_LEVEL=INFO

# Email delivery (EMAIL_* or SMTP_* names both work). For Gmail use an app password, not your normal password.
# Business outreach is always drafted first and sent only after you say "send it" or press Send.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USER=you@example.com
EMAIL_PASS=
# Optional full address (e.g. you@gmail.com); defaults to EMAIL_USER. Gmail only sends as the login or a verified alias.
EMAIL_FROM=
# Your own inbox(es) for reports ("email me a summary"); comma separated
ADMIN_EMAILS=you@example.com
MAX_EMAILS_HOUR=10
# Sender profile: who "we" are. NOVA introduces you with this in every outreach email and builds the signature from it.
OWNER_NAME=
OWNER_TITLE=
BUSINESS_NAME=
# One or two sentences, e.g. "We design fast, bookable websites for studios and cafes in Hyderabad."
BUSINESS_ABOUT=
BUSINESS_WEBSITE=
BUSINESS_PHONE=
# How NOVA addresses you when speaking (e.g. "sir", or your first name). Defaults to OWNER_NAME's first name.
OWNER_ADDRESS=
# jarvis (composed personal-aide personality) or neutral
PERSONA=jarvis
# Offline wake word: hey_nova (local Moonshine speech model) or an openWakeWord model (hey_jarvis, alexa, hey_mycroft).
# Threshold 0.2-0.95; raise it if it wakes by mistake.
WAKE_WORD=hey_nova
WAKE_THRESHOLD=0.5
# Accent colour for the HTML email design
BRAND_COLOR=#5b4bff
